# Anonymization Environment Configuration
# Copy this file to .env to enable anonymization mode

# Claude API Configuration (Required)
ANTHROPIC_API_KEY=sk-ant-xxx  # Replace with your actual API key

# Production Netbox Configuration (Required)
# Used when anonymization is disabled
NETBOX_URL=http://localhost:8000/api/
NETBOX_TOKEN=your-production-token  # Replace with actual token

# Anonymization Settings
ANONYMIZATION_ENABLED=true
ANONYMIZATION_MODE=greenmask
ANONYMIZATION_SEED=change-me-to-random-seed  # IMPORTANT: Use a secure random seed

# Anonymized Netbox Configuration
# These URLs depend on your deployment:
# - If MCP runs on HOST (current setup): use localhost URLs
# - If MCP runs in Docker (future): use container names
NETBOX_ANON_URL=http://localhost:8001/api/  # Anonymized Netbox instance
NETBOX_ANON_TOKEN=your-anonymized-token  # Replace with actual token

# Greenmask Mappings
GREENMASK_MAPPINGS_FILE=backend/anonymization/mappings/mappings_latest.json

# Anonymization Options
ANONYMIZE_VENDORS=true  # Preserve vendor/model names for better Claude reasoning

# Application Settings
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Optional: LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=netbox-chatbox

# Docker Environment Variables (for docker-compose)
# Used by Greenmask when running via Docker Compose
SOURCE_DB_HOST=netbox-prod-db
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=netbox
SOURCE_DB_USER=netbox
SOURCE_DB_PASSWORD=netbox

TARGET_DB_HOST=netbox-anon-db
TARGET_DB_PORT=5432
TARGET_DB_NAME=netbox_anonymized
TARGET_DB_USER=netbox
TARGET_DB_PASSWORD=netbox

# Notes:
# 1. NEVER commit this file with real API keys to version control
# 2. Generate a secure random seed for ANONYMIZATION_SEED
# 3. Ensure NETBOX_ANON_URL points to the anonymized instance (port 8001)
# 4. Run Docker Compose first to create both Netbox instances:
#    docker-compose -f docker/docker-compose.anonymization.yml up
# 5. Run Greenmask to create anonymized copy:
#    docker-compose -f docker/docker-compose.anonymization.yml run greenmask
# 6. Import mappings:
#    python scripts/import_mappings.py docker/greenmask/mappings/mappings_latest.json